	month = dec,
	year = {2015},
	keywords = {Coherent Doppler lidar (CDL), Detectors, fiber laser, field-programmable gate array (FPGA), maximum-likelihood estimator, Noise, Optical mixing, Optical pulses, Optical receivers, Optical scattering, wind sensing},
	pages = {6495--6506},
	file = {Full Text PDF:C\:\\Users\\thoma\\Zotero\\storage\\J8RXBEPV\\Abdelazim et al. - 2015 - Development and Operational Analysis of an All-Fiber Coherent Doppler Lidar System for Wind Sensing.pdf:application/pdf},
